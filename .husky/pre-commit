#!/bin/sh

# Formatting and lint on the staged files only, so committing stays under a few
# seconds. Type checking and the release checks belong to CI (`npm run check`):
# a hook that takes minutes is a hook people bypass with --no-verify.

staged_list=$(mktemp)
trap 'rm -f "$staged_list"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z > "$staged_list"
if [ ! -s "$staged_list" ]; then
  exit 0
fi

echo "Formatting and linting staged files..."
if ! xargs -0 npx biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true < "$staged_list"; then
  echo "Fix the reported problems before committing. Run 'npm run check' for the full suite."
  exit 1
fi

# Restage what the formatter rewrote.
xargs -0 git add -- < "$staged_list"
